# Copy this file to .env and fill in your own values.
# NEVER commit the real .env to git or share it with anyone.

# --- BingX API credentials ---
# Create a key in BingX under API Management with:
# - "Perpetual Futures" trading permission ON
# - Withdrawals permission OFF (always)
# - IP whitelist set to the server this bot runs on
BINGX_API_KEY=
BINGX_API_SECRET=

# --- Market ---
SYMBOLS=BTC/USDT:USDT
TIMEFRAME=15m
CANDLE_LIMIT=300

# --- Strategy ---
FRACTAL_N=2
# Fixed by the strategy at 2 (take-profit is always twice the stop-loss
# distance) -- config.py forces this regardless of what's set here.
REWARD_RISK_RATIO=2

# --- Top-down higher-timeframe trend filter ---
# Weekly -> daily -> 4h -> 1h, highest timeframe first. Only the PRIMARY
# levels below can veto a trade on disagreement -- the rest are analyzed
# and logged every cycle but are for entry timing only, never a veto.
TREND_FILTER_ENABLED=true
HTF_TIMEFRAMES=1w,1d,4h,1h
HTF_PRIMARY_TIMEFRAMES=1w,1d
TREND_EMA_PERIOD=50
TREND_CANDLE_LIMIT=150

# --- Risk management ---
# Fixed margin (USDT) committed to every trade. Leverage is then solved
# per trade from the stop-loss distance so the trade's risk hits
# RISK_PCT_PER_TRADE of equity -- see risk_manager.position_size().
MARGIN_PER_TRADE_USD=50
# Target risk per trade, as % of equity. Hard-capped at 3% in config.py
# no matter what this is set to; defaults to that same 3% ceiling, so by
# default every trade risks up to the maximum allowed.
RISK_PCT_PER_TRADE=3
# Leverage CEILING for the auto-sizer above -- the leverage it solves for
# per trade never exceeds this (or the 10x hard cap, whichever is lower).
LEVERAGE=3
MAX_DAILY_LOSS_PCT=3
MAX_CONCURRENT_POSITIONS=1
# Second, independent cap: no matter how tight a stop-loss makes the
# leverage-based position size, open positions combined may never
# require more than this fraction of equity*10x(hard cap) in margin.
MAX_MARGIN_UTILIZATION_PCT=50

# --- Partial take-profit + trailing stop ---
# At 1R (the same distance as the initial risk), half the position
# closes and the stop for the rest moves to breakeven; from there the
# remainder trails with no fixed cap, instead of every winner being
# capped at the fixed 2R take-profit. Set PARTIAL_TP_FRACTION=0 to
# disable this and fall back to a fixed-2R-take-profit-only exit.
PARTIAL_TP_R_MULTIPLE=1.0
PARTIAL_TP_FRACTION=0.5
TRAIL_R_MULTIPLE=1.0
# TP2: fraction of the ORIGINAL position closed at the next swing high/low beyond TP1
TP2_FRACTION=0.3
# TP2 when no swing beyond TP1 exists, in multiples of the initial risk
TP2_FALLBACK_R_MULTIPLE=2.0

# --- Cost modeling ---
# Round-trip taker-fee estimate applied to DRY_RUN's simulated P/L only,
# so paper-trading stats aren't rosier than live trading will be. Check
# your account's actual fee tier and adjust if it differs.
DRY_RUN_FEE_PCT_PER_SIDE=0.05

# --- Safety switch: keep this "true" until you've fully validated the bot ---
DRY_RUN=true
